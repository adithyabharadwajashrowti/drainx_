# Copy this file to .env (same folder) and fill in your values.
# NEVER upload .env to GitHub.

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=paste-the-service_role-secret-key-here

# Arduino port: Windows e.g. COM3 | Mac e.g. /dev/cu.usbmodem14101 | Linux e.g. /dev/ttyACM0
SERIAL_PORT=COM3

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefYourTokenHere

# Pothole model weights (downloaded from Colab after training)
POTHOLE_MODEL=best.pt
POTHOLE_SEGMENT=J2

# Centre of the digital-twin ward (Silk Board by default)
TWIN_LAT=12.9177
TWIN_LNG=77.6238
